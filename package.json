{
  "name": "teardown",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:engine": "./scripts/build-engine.sh",
    "app": "vite build && ./scripts/build-engine.sh && tauri build",
    "tauri": "tauri",
    "build:mcp": "esbuild server/mcp.ts --bundle --platform=node --format=esm --target=node20 --outfile=build/teardown-mcp.mjs --log-level=warning",
    "mcp": "tsx server/mcp.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "plist": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "version": "0.3.0"
}
