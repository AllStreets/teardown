{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teardown",
  "version": "0.2.0",
  "identifier": "com.allstreets.teardown",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Teardown",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#07111C",
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "AllStreets",
    "shortDescription": "X-ray the apps on your Mac",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/teardown-engine"],
    "resources": { "../dist/": "dist/" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
